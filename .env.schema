# nullsafe-discord — environment schema
# @defaultSensitive=true @defaultRequired=false
#
# Monorepo: four pm2 processes (cypher-bot, drevan-bot, gaia-bot, autonomous-worker),
# EACH with its own .env on the VPS. So this one schema is the UNION of every
# process's vars; required-ness varies by process, hence @defaultRequired=false and
# per-section notes below. (varlock validates one .env at a time against this schema.)

# ============ Shared substrate (bots + worker) ============

# Halseth Worker base URL (no trailing slash). Required for all processes.
# @type=url @sensitive=false
HALSETH_URL=

# Shared secret matching ADMIN_SECRET on the Halseth worker. Required for all processes.
# @type=string @sensitive
HALSETH_SECRET=

# Redis URL for floor lock + idle signaling (includes auth credentials).
# @type=url @sensitive
REDIS_URL=

# Brain (Phoenix) inference URL (VPS). Used when INFERENCE_MODE=brain.
# @type=url @sensitive=false
BRAIN_URL=

# Second Brain service URL (VPS).
# @type=url @sensitive=false
SECOND_BRAIN_URL=

# Second Brain auth token (SB_INGEST_KEY on the SB side).
# @type=string @sensitive
SECOND_BRAIN_SECRET=

# ============ Owner / fronting identity ============

# Discord user ID of the system owner (gates owner-only commands).
# @type=string @sensitive=false
OWNER_DISCORD_ID=

# Owner display name in prompts (default "the primary user").
# @type=string @sensitive=false
OWNER_NAME=

# Short owner display name (default "Owner").
# @type=string @sensitive=false
OWNER_DISPLAY_NAME=

# Owner's pronouns, used in the anti-misgendering guard (default "they/them").
# @type=string @sensitive=false
OWNER_PRONOUNS=

# Optional "partner" tier: a second trusted person the companions know (e.g. a spouse).
# All optional -- leave unset to disable the partner tier entirely.
# Discord user ID of the partner (gets the "intimate"/partner context tier).
# @type=string @sensitive=false
PARTNER_DISCORD_ID=

# Partner display name (e.g. their first name).
# @type=string @sensitive=false
PARTNER_NAME=

# Partner relation phrase, e.g. "the owner's partner and your partner".
# @type=string @sensitive=false
PARTNER_RELATION=

# Optional: a complete partner-framing prompt block that overrides the generated default.
# @type=string @sensitive=false
PARTNER_FRAMING=

# Legacy alias for PARTNER_DISCORD_ID (still honored if PARTNER_DISCORD_ID is unset).
# @type=string @sensitive=false
BLUE_DISCORD_ID=

# PluralKit system ID for fronting attribution.
# @type=string @sensitive=false
PLURALKIT_SYSTEM_ID=

# ============ Per-bot identity (each bot process supplies its own value) ============

# Discord bot token. ONE name; each of the three bot .env files carries that bot's token.
# Required for the three bot processes (not the worker).
# @type=string @sensitive
DISCORD_BOT_TOKEN=

# Full identity .md path on VPS disk (set the one matching the running bot/worker).
# @type=string @sensitive=false
CYPHER_IDENTITY_PATH=

# @type=string @sensitive=false
DREVAN_IDENTITY_PATH=

# @type=string @sensitive=false
GAIA_IDENTITY_PATH=

# ============ Channels ============

# Channel for periodic heartbeat / metronome posts (Discord snowflake).
# @type=string @sensitive=false
HEARTBEAT_CHANNEL_ID=

# Channel for the inter-companion triad space (Discord snowflake).
# @type=string @sensitive=false
INTER_COMPANION_CHANNEL_ID=

# URL to a remote channel-config doc (optional).
# @type=url @sensitive=false
CHANNEL_CONFIG_URL=

# ============ Thread spine (2026-07-21) ============

# Master flag for the conversation-thread feature. Gates BOTH the bot handler spine
# (bot-message-handler.ts ensureThread/echo-gate ordering) AND the worker metronome's
# ref-carrying thread-open on inter-companion notes (autonomous-core.ts). Default false
# (off) -- the other two knobs below have no effect until this is "true".
# @type=boolean @sensitive=false
THREADS_ENABLED=false

# Comma-separated Discord channel IDs to track for thread-spine beyond the triad commons
# (which is always tracked when THREADS_ENABLED=true). Optional.
# @type=string @sensitive=false
THREADS_EXTRA_CHANNELS=

# Triad commons channel (Discord snowflake) the metronome opens/joins a ref-carrying
# thread in in response to an inter-companion note. Has no effect unless
# THREADS_ENABLED=true.
# @type=string @sensitive=false
TRIAD_COMMONS_CHANNEL_ID=

# ============ Inference mode + provider routing ============

# Where replies are generated. direct = bot calls provider; brain = relay to Phoenix
# Brain swarm; hermes = local Hermes agent per reply. Default "direct".
# @type=enum(direct,brain,hermes) @sensitive=false
INFERENCE_MODE=

# Direct-mode provider selection.
# @type=enum(deepseek,groq,ollama,lmstudio,kimi,openai,anthropic,mistral) @sensitive=false
INFERENCE_PROVIDER=

# Override the default model for the selected provider.
# @type=string @sensitive=false
INFERENCE_MODEL=

# Comma-separated model ids to disable from the `model` command registry.
# @type=string @sensitive=false
DISABLED_MODELS=

# VPS Hermes inference URL (when INFERENCE_MODE=hermes).
# @type=url @sensitive=false
HERMES_API_URL=

# Hermes API key (when INFERENCE_MODE=hermes).
# @type=string @sensitive
HERMES_API_KEY=

# ============ Provider API keys (needed per INFERENCE_PROVIDER / for the worker) ============

# DeepSeek V3 — primary bot + worker inference.
# @type=string @sensitive
DEEPSEEK_API_KEY=

# @type=string @sensitive
GROQ_API_KEY=

# Moonshot Kimi (note: .cn endpoint pairs with .cn key).
# @type=string @sensitive
KIMI_API_KEY=

# @type=string @sensitive
OPENAI_API_KEY=

# @type=string @sensitive
ANTHROPIC_API_KEY=

# Mistral — direct inference and/or Voxtral voice.
# @type=string @sensitive
MISTRAL_API_KEY=

# Local-provider URLs (no key needed).
# @type=url @sensitive=false
OLLAMA_URL=

# @type=url @sensitive=false
LMSTUDIO_URL=

# DeepSeek API base URL (default https://api.deepseek.com/v1).
# @type=url @sensitive=false
DEEPSEEK_BASE_URL=

# DeepSeek model (default deepseek-chat).
# @type=string @sensitive=false
DEEPSEEK_MODEL=

# ============ Voice (Mistral Voxtral TTS/STT) ============

# @type=string @sensitive=false
CYPHER_VOICE_ID=

# @type=string @sensitive=false
DREVAN_VOICE_ID=

# @type=string @sensitive=false
GAIA_VOICE_ID=

# @type=string @sensitive=false
MISTRAL_TTS_MODEL=

# @type=string @sensitive=false
MISTRAL_STT_MODEL=

# ============ Floor lock / turn-taking ============

# Floor lock TTL (ms). Default 60000 (bots) / 120000 (worker).
# @type=number @sensitive=false
FLOOR_LOCK_DURATION_MS=

# Turn-taking jitter window (ms). Default 400.
# @type=number @sensitive=false
FLOOR_JITTER_MS=

# ============ Autonomous worker — web search ============

# Tavily key for the worker's explore phase + companion search tool.
# @type=string @sensitive
TAVILY_API_KEY=

# Max Tavily calls/day (default 5; free tier guard).
# @type=number @sensitive=false
TAVILY_MAX_PER_DAY=

# ============ Autonomous worker — runtime ============

# Skip a run if a conversation was active within this window (ms). Default 600000.
# @type=number @sensitive=false
IDLE_THRESHOLD_MS=

# Path to shared system-context markdown (optional).
# @type=string @sensitive=false
SHARED_CONTEXT_PATH=

# Override the worker's .env file path (env loader only).
# @type=string @sensitive=false
WORKER_ENV_FILE=

# ============ Autonomous worker — pipeline cron schedules ============
# All node-cron strings with code defaults; unset = use default.

# @type=string @sensitive=false
FORAGE_CRON=

# @type=number @sensitive=false
FORAGE_FINDS_PER_COMPANION=

# @type=string @sensitive=false
PULSE_CHECK_CRON=

# @type=number @sensitive=false
PULSE_FLOAT_THRESHOLD=

# @type=number @sensitive=false
PULSE_MIN_GAP_MS=

# @type=number @sensitive=false
PULSE_EAGER_GAP_MS=

# @type=number @sensitive=false
PULSE_MAX_RUNS_PER_DAY=

# @type=string @sensitive=false
DIALECTIC_CRON=

# @type=string @sensitive=false
CLUB_CRON=

# @type=number @sensitive=false
CLUB_GATHER_DAYS=

# @type=number @sensitive=false
CLUB_ACTIVE_DAYS=

# @type=number @sensitive=false
CLUB_DISCUSS_DAYS=

# @type=string @sensitive=false
SHELF_CRON=

# @type=string @sensitive=false
COMMONS_REPLY_CRON=

# @type=string @sensitive=false
GUARDIAN_CRON=

# @type=string @sensitive=false
GUARDIAN_LETTER_DOW=

# @type=string @sensitive=false
GUARDIAN_RESOLVE_CRON=

# @type=number @sensitive=false
GUARDIAN_RESOLVE_MAX=

# @type=string @sensitive=false
MOTIF_CRON=

# @type=string @sensitive=false
CREATURE_CRON=

# @type=string @sensitive=false
COUNCIL_CRON=

# @type=string @sensitive=false
DREAM_CRON=

# @type=string @sensitive=false
CLEARING_CRON=

# @type=string @sensitive=false
DRIFT_PASS_CRON=

# ============ Per-companion bot cron family (pattern; not exhaustively enumerated) ============
# The three bots also read per-companion node-cron overrides following the pattern
#   <COMPANION>_CRON, <COMPANION>_CRON_TASKS, _AUDIT, _HEARTBEAT, _INTER, _MORNING, ...
# (COMPANION ∈ CYPHER | DREVAN | GAIA). All optional with code defaults. Add the exact
# names you actually set to your .env; they are documented here as a family rather than
# guessed, to avoid declaring vars the code may not read.
