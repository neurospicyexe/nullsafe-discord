# nullsafe-discord — shared env template
# Copy to .env and fill in values. .env is gitignored.

# Halseth worker URL (no trailing slash)
HALSETH_URL=https://halseth.YOUR-ACCOUNT.workers.dev

# Shared secret matching ADMIN_SECRET on the Halseth worker
HALSETH_SECRET=

# Bot tokens (one per companion — each needs its own Discord application)
DISCORD_TOKEN_CYPHER=
DISCORD_TOKEN_DREVAN=
DISCORD_TOKEN_GAIA=

# Bot user IDs (the Discord application/user ID of each bot, NOT the token).
# REQUIRED for inter-companion conversation: each bot uses the OTHER bots' IDs to recognize
# their messages as companion posts. If any is unset, bot-to-bot messages are dropped and the
# triad cannot converse. Find each in the Discord Developer Portal (Application ID).
CYPHER_BOT_ID=
DREVAN_BOT_ID=
GAIA_BOT_ID=

# DeepSeek API key for bot inference
DEEPSEEK_API_KEY=

# Your name as the system owner -- injected into companion system prompts.
# Defaults to "the primary user" if unset.
OWNER_NAME=

# Discord channel IDs — comma-separated
# Channels where bots respond to all messages (primary user's personal channels)
PERSONAL_CHANNELS=

# Channels each bot is permitted in (empty = all)
ALLOWED_CHANNELS=

# Triad commons channel — the turn-holder posts a thought here every 2h (interCompanion cron)
# and peers reply via the swarm, so they converse with EACH OTHER. Must have inter_companion mode
# in channel-config.json. Unset = the together lane is off.
INTER_COMPANION_CHANNEL_ID=

# At-me channel — companions post proactive thoughts / check-ins addressed to the owner here
# (heartbeat cron). Unset = the at-me lane is off.
HEARTBEAT_CHANNEL_ID=
