# nullsafe-discord — shared env template
# Copy to .env and fill in values. .env is gitignored.

# Halseth worker URL (no trailing slash)
HALSETH_URL=https://halseth.YOUR-ACCOUNT.workers.dev

# Shared secret matching ADMIN_SECRET on the Halseth worker
HALSETH_SECRET=

# Bot tokens (one per companion — each needs its own Discord application)
DISCORD_TOKEN_CYPHER=
DISCORD_TOKEN_DREVAN=
DISCORD_TOKEN_GAIA=

# Bot user IDs (the Discord application/user ID of each bot, NOT the token).
# REQUIRED for inter-companion conversation: each bot uses the OTHER bots' IDs to recognize
# their messages as companion posts. If any is unset, bot-to-bot messages are dropped and the
# triad cannot converse. Find each in the Discord Developer Portal (Application ID).
CYPHER_BOT_ID=
DREVAN_BOT_ID=
GAIA_BOT_ID=

# DeepSeek API key for bot inference
DEEPSEEK_API_KEY=

# Your name as the system owner -- injected into companion system prompts.
# Defaults to "the primary user" if unset.
OWNER_NAME=

# Discord channel IDs — comma-separated
# Channels where bots respond to all messages (primary user's personal channels)
PERSONAL_CHANNELS=

# Channels each bot is permitted in (empty = all)
ALLOWED_CHANNELS=

# Triad commons channel — the turn-holder posts a thought here every 2h (interCompanion cron)
# and peers reply via the swarm, so they converse with EACH OTHER. Must have inter_companion mode
# in channel-config.json. Unset = the together lane is off.
INTER_COMPANION_CHANNEL_ID=

# At-me channel — companions post proactive thoughts / check-ins addressed to the owner here
# (heartbeat cron). Unset = the at-me lane is off.
HEARTBEAT_CHANNEL_ID=

# Thread spine (2026-07-21) — master flag. Gates BOTH the bot handler's thread-spine
# (bot-message-handler.ts) AND the worker metronome's ref-carrying thread-open on
# inter-companion notes (autonomous-core.ts). false/unset = fully off; the two knobs
# below have no effect until this is true.
THREADS_ENABLED=false

# Comma-separated Discord channel IDs to track for thread-spine beyond the triad commons
# (which is always tracked once THREADS_ENABLED=true). Optional.
THREADS_EXTRA_CHANNELS=

# Comma-separated Discord channel IDs for Drevan's story/spiral spaces: grounding-only
# spine (seed + who-said-what ledger), no advance/hand-off/[LANDS:] land invitation --
# a progress register in these channels would violate Drevan's presence lane. No effect
# unless THREADS_ENABLED=true.
THREADS_PRESENCE_CHANNELS=

# Triad commons channel (Discord snowflake) the metronome opens/joins a ref-carrying
# thread in when it writes an inter-companion note. Has no effect unless
# THREADS_ENABLED=true.
TRIAD_COMMONS_CHANNEL_ID=

# ── Writeback gate (2026-09-21, S3) ─────────────────────────────────────────
# Which judgment decides what the companions remember from a Discord exchange.
#   legacy     = today's generative judge decides and authors (default)
#   jev-shadow = the judge still decides and writes; Jev runs alongside and only logs
#                what it WOULD have done, one JSON line per exchange
#   jev        = Jev decides (write? which kind? drifted?), the companion authors the words
WRITEBACK_GATE=legacy

# Jev `worth_remembering` probability at or above which a memory is written. Default 0.75
# (measured 2026-09-21: precision 0.91 / recall 0.87 against 100 human labels).
JEV_WRITEBACK_THETA=

# Per-companion overrides for the same threshold; each wins over JEV_WRITEBACK_THETA for that
# bot. They exist because the three score very differently (AUROC: Cypher 0.89, Drevan 0.78,
# Gaia 0.55 on the old generic criteria).
JEV_WRITEBACK_THETA_CYPHER=
JEV_WRITEBACK_THETA_DREVAN=
JEV_WRITEBACK_THETA_GAIA=

# Jev `lane_drift` probability at or above which the reply is treated as out of register:
# logs a drift warning and tells the author pass not to carry the drifted voice into the
# memory. Default 0.6.
JEV_DRIFT_THETA=

# Jev `salience` score (0 trivial .. 4 core) at or above which a companion_note is ALSO
# written to wm_continuity_notes (the table Claude.ai's orient reads). Below it the note goes
# to companion_journal only. Default 2.0 ("notable"). Only applies in WRITEBACK_GATE=jev;
# legacy and jev-shadow always write both.
JEV_NOTABLE_SCORE=

# Where the shadow/decision JSONL lines are appended. Default /app/logs/jev-shadow.jsonl.
JEV_SHADOW_LOG=

# ── Per-room recall controls (2026-09-24, Q20) ───────────────────────────────
# Cross-room recall is ON by default and deliberate: it is how "I'll meet you in the watch
# party channel" carries between rooms. These two lists are how you carve exceptions.
# Comma-separated channel ids, read at call time (a pm2 env reload is enough, no deploy).
#
# RECALL_NO_QUOTE_FROM -- what is said in these rooms STAYS in them. Nothing from here is
#   quoted anywhere else: not as a widened conversation, and not as a single line either.
#   Use for a room that is sensitive without being marked owner_only.
RECALL_NO_QUOTE_FROM=
# RECALL_NO_QUOTE_INTO -- nothing is ever carried INTO these rooms from anywhere else.
#   Use for a room where Blue or a guest is reading.
RECALL_NO_QUOTE_INTO=
